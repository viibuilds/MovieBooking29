<?xml version="1.0"?>
<configuration>
  <connectionStrings>
    <add name="MovieBookingConnection29"
         connectionString="Data Source=(LocalDB)\v11.0;Initial Catalog=MovieBookingDB29;Integrated Security=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
  </appSettings>

  <system.web>
    <compilation debug="true" targetFramework="4.5" />
    <httpRuntime targetFramework="4.5" />
  </system.web>
</configuration>
